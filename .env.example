# --- Required: LLM Configuration ---
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_llm_api_key_here
MODEL_NAME=qwen-plus

# --- Optional: Server Port (Default 3000) ---
PORT=3000

# --- Optional: Web Search Tool (Bocha API) ---
BOCHA_API_KEY=your_bocha_api_key_here

# --- Optional: Send Mail Tool (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=your_email@example.com

# --- Optional: MySQL (user / job CRUD via TypeORM) ---
# Defaults in src/app.module.ts: host localhost, db hello, user root

# --- Optional: Milvus (RAG vector store) ---
# Local Docker: milvus-standalone maps 19530:19530
MILVUS_ADDRESS=localhost:19530
MILVUS_COLLECTION=rag_docs
MILVUS_USER=
MILVUS_PASSWORD=
# Embedding model (OpenAI-compatible; often same OPENAI_BASE_URL / OPENAI_API_KEY)
EMBEDDING_MODEL=text-embedding-v3
RAG_DOCS_PATH=docs/rag-sample
RAG_TOP_K=4
